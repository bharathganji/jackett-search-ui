{
  "name": "jackett-search-ui",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Modern React-based UI for Jackett torrent search with real-time streaming results, advanced filtering, mobile-responsive design, and efficient caching",
  "keywords": [
    "jackett",
    "torrent",
    "search",
    "react",
    "typescript",
    "vite",
    "ui",
    "modern",
    "real-time",
    "streaming",
    "mobile-responsive",
    "virtualization",
    "caching",
    "tailwindcss",
    "shadcn"
  ],
  "author": "Bharath Ganji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharathganji/jackett-search-ui.git"
  },
  "bugs": {
    "url": "https://github.com/bharathganji/jackett-search-ui/issues"
  },
  "homepage": "https://github.com/bharathganji/jackett-search-ui#readme",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "preview": "vite preview",
    "prepare": "husky",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "version": "echo 'Version updated to' $npm_package_version",
    "postversion": "git push && git push --tags"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-github-btn": "^1.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "9.33.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.10",
    "terser": "^5.43.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
